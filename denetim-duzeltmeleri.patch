+[pytest]
+# Test keşfi kök dizinden; tests/ paket olduğu için PYTHONPATH=. gerekir
+# (CI ve conftest.py bunu ayarlar).
+testpaths = tests
+python_files = test_*.py
+python_classes = Test*
+python_functions = test_*
+
+# pytest-asyncio: @pytest.mark.asyncio ile işaretli testler çalışsın.
+asyncio_mode = strict
+
+# Uyarıları görünür tut ama testleri kırma.
+filterwarnings =
+    default
+    ignore::DeprecationWarning:pkg_resources.*
+
+markers =
+    db: canlı Postgres gerektirir (CI'da ayrı job, RUN_DB_TESTS=1)
+    slow: yavaş test
+
+# Kısa ve okunur çıktı
+addopts = -q --strict-markers --tb=short
